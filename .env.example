# Copy to .env and fill in the values. NEVER commit .env files.

# Required - session cookie encryption (at least 32 characters)
STS_SESSION_SECRET=change-me-to-a-long-random-string

# Required - Discord OAuth application
# The redirect URI must be registered in the Discord developer portal
# (Applications -> OAuth2 -> Redirects):
#   https://sts.deepa.cat/api/auth/discord/callback         (production)
#   https://dev.deepa.cat/api/auth/discord/callback     (dev)
#   http://localhost:3001/api/auth/discord/callback         (local dev)
STS_DISCORD_CLIENT_ID=
STS_DISCORD_CLIENT_SECRET=

# Optional - the app's public origin. The Discord OAuth redirect URI and
# post-login redirects are derived from the request by default, but behind a
# reverse proxy the Host header can be wrong. Pin it per environment:
#   https://sts.deepa.cat  (production)
#   https://dev.deepa.cat  (dev)
STS_PUBLIC_BASE_URL=

# Optional - API rate limits and daily upload limits. Request limits are per
# IP and enforced in proxy.js; daily limits are per account (site and mod
# share the budget), with anonymous builds counted per IP (site) or UUID (mod).
# Set a value to 0 to disable that limit. Restart with pm2 restart sts --update-env.
#STS_API_RATE_LIMIT_PER_MINUTE=600
#STS_API_WRITE_RATE_LIMIT_PER_MINUTE=60
#STS_LIMIT_BUILDS_PER_DAY=100
#STS_LIMIT_CUSTOM_ITEMS_PER_DAY=200
#STS_LIMIT_ANONYMOUS_BUILDS_PER_DAY=20

# Optional - database backups. The server snapshots data/sts-builds.db daily
# (see lib/db-backup-scheduler.js), keeps 30 days of copies locally under
# data/backups and deletes older ones. Manual use: npm run backup:db / backup:db:list.
# After changing these on the server, restart with: pm2 restart sts --update-env
#STS_BACKUP_DISABLED=0
#STS_BACKUP_INTERVAL_HOURS=24
#STS_BACKUP_INITIAL_DELAY_MINUTES=2
#STS_BACKUP_MAX_AGE_DAYS=30
#STS_BACKUP_KEEP=1
#STS_BACKUP_DIR=

# Optional - offsite backup copies in Cloudflare R2 (S3 API token scoped to
# the bucket: Object Read & Write). When unset, backups stay local only.
# Keys are sts-builds/backups/<host>/<file> - the STS_PUBLIC_BASE_URL host on
# servers, or the machine hostname elsewhere - so instances can share a bucket
# without pruning each other. Set R2_PREFIX to override with a fixed prefix.
#R2_ACCOUNT_ID=
#R2_ACCESS_KEY_ID=
#R2_SECRET_ACCESS_KEY=
#R2_BUCKET=
#R2_PREFIX=
