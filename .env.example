# Copy to .env and fill in the values. NEVER commit .env files.

# Required - session cookie encryption (at least 32 characters)
STS_SESSION_SECRET=change-me-to-a-long-random-string

# Required - Discord OAuth application
# The redirect URI must be registered in the Discord developer portal
# (Applications -> OAuth2 -> Redirects):
#   https://sts.deepa.cat/api/auth/discord/callback         (production)
#   https://dev.deepa.cat/api/auth/discord/callback     (dev)
#   http://localhost:3001/api/auth/discord/callback         (local dev)
STS_DISCORD_CLIENT_ID=
STS_DISCORD_CLIENT_SECRET=

# Optional - the app's public origin. The Discord OAuth redirect URI and
# post-login redirects are derived from the request by default, but behind a
# reverse proxy the Host header can be wrong. Pin it per environment:
#   https://sts.deepa.cat      (production)
#   https://dev.deepa.cat  (dev)
STS_PUBLIC_BASE_URL=
